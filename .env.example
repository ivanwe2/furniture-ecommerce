# Copy to .env and fill in. NEVER commit .env. This file lists keys only.
# In production the sysadmin owns the host .env (read by the container).

# --- Core ---
# openssl rand -hex 32
PAYLOAD_SECRET=
# SQLite database file. In the container this lives on the `data` volume.
# Local dev: file:./nasteh.db
DATABASE_URI=file:/app/data/nasteh.db
# Directory for uploaded media. In the container this is the `media` volume.
# Local dev: media
MEDIA_DIR=/app/media

# --- Public (compiled into the client bundle at build time) ---
# Public base URL of the site (the address behind the reverse proxy)
NEXT_PUBLIC_SITE_URL=https://nasteh.bg
# Dual EUR/BGN price display ('true' until 2026-08-08, then 'false')
NEXT_PUBLIC_SHOW_BGN=true
# Cloudflare Turnstile site key (public widget id)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Anti-bot (Turnstile server-side verify) ---
TURNSTILE_SECRET_KEY=

# --- Email (authenticated SMTP endpoint for the domain; sysadmin-provided) ---
# Host/port of the SMTP relay. Port 465 = implicit TLS; 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
# Leave USER/PASS empty for a no-auth local relay.
SMTP_USER=
SMTP_PASS=
# Envelope sender — must be an address the SMTP endpoint is allowed to send as.
EMAIL_FROM=Настех <orders@nasteh.bg>
# Inbox that receives order + contact notifications
ORDER_INBOX_EMAIL=
