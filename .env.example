# Copy to .env and fill in. NEVER commit .env. This file lists keys only.
# In production the sysadmin owns the host .env (read by the container).

# --- Core ---
# openssl rand -hex 32
PAYLOAD_SECRET=
# PostgreSQL connection string. In the stack this points at the `db` service on
# the internal network; its data lives on the `pgdata` volume. Must match the
# POSTGRES_USER/PASSWORD/DB below. Local dev (host Postgres):
# postgres://postgres:postgres@localhost:5432/nasteh
DATABASE_URI=postgres://nasteh:CHANGE_ME_STRONG_PASSWORD@db:5432/nasteh

# --- Postgres container (docker-compose `db` service) ---
POSTGRES_USER=nasteh
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=nasteh

# --- Redis (rate-limit store; docker-compose `redis` service) ---
# If unset, the app falls back to an in-process limiter (fine for one instance).
REDIS_URL=redis://redis:6379
# Directory for uploaded media. In the container this is the `media` volume.
# Local dev: media
MEDIA_DIR=/app/media

# --- Public (compiled into the client bundle at build time) ---
# Public base URL of the site (the address behind the reverse proxy)
NEXT_PUBLIC_SITE_URL=https://nasteh.bg
# Dual EUR/BGN price display ('true' until 2026-08-08, then 'false')
NEXT_PUBLIC_SHOW_BGN=true

# --- Pre-launch site lock (HTTP Basic Auth over the storefront) ---
# Set BOTH to gate the public site while content is still being prepared, so a
# stray visitor can't mistake it for an open shop and place an order. /admin and
# /api stay reachable (Payload has its own login). ASCII only.
# Read at RUNTIME (unlike NEXT_PUBLIC_*), so no rebuild is needed.
# To GO LIVE: empty both, then `docker compose up -d app` (see DEPLOY.md §8).
SITE_LOCK_USER=
SITE_LOCK_PASSWORD=

# --- Anti-bot (Altcha — self-hosted proof-of-work; no external service) ---
# HMAC secret that signs + verifies challenges. openssl rand -hex 32
ALTCHA_HMAC_KEY=

# --- Email: the app relays through the in-stack `mail` service ---
# Default points at the internal Postfix relay (no auth on the internal
# network). To use an external smarthost directly instead, set these to it.
SMTP_HOST=mail
SMTP_PORT=587
# Leave USER/PASS empty for the no-auth internal relay.
SMTP_USER=
SMTP_PASS=
# Envelope sender — must be a `MAIL_SENDER_DOMAINS` address (DKIM-signed).
EMAIL_FROM=Настех <orders@nasteh.bg>
# Inbox that receives order + contact notifications
ORDER_INBOX_EMAIL=

# --- Mail relay (docker-compose `mail` service; Postfix + OpenDKIM) ---
# The relay's hostname (used in SMTP HELO + DKIM) and the domain(s) it may send
# as. After first boot, publish the generated DKIM record + SPF/DMARC — see
# DEPLOY.md §mail. Deliverability needs open outbound :25 + PTR, OR a RELAYHOST.
MAIL_HOSTNAME=mail.nasteh.bg
MAIL_SENDER_DOMAINS=nasteh.bg
# Optional smarthost (e.g. [smtp.provider.com]:587) for hosts where outbound
# :25 is blocked. Leave empty for direct delivery.
RELAYHOST=
RELAYHOST_USERNAME=
RELAYHOST_PASSWORD=
