# Secrets (set via wrangler secret put in prod, .env locally)
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
# Resend API key for transactional emails
RESEND_API_KEY=
# Cloudflare Turnstile secret key (server-side verify)
TURNSTILE_SECRET_KEY=
# Email address that receives order notifications
ORDER_INBOX_EMAIL=

# Public variables (committed as wrangler vars / NEXT_PUBLIC_ env)
# Base URL of the site (used for metadata, redirects, etc.)
NEXT_PUBLIC_SITE_URL=https://nasteh.bg
# Dual EUR/BGN price display flag ('true' until 2026-08-08, then 'false')
NEXT_PUBLIC_SHOW_BGN=true
# Cloudflare Turnstile site key (public/widget ID)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# R2 media bucket hostname for image transformations
NEXT_PUBLIC_MEDIA_HOST=media.nasteh.bg
