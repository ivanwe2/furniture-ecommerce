{
  "name": "nasteh-bg",
  "version": "1.0.0",
  "description": "Nasteh OOD furniture-fittings catalog (Payload + Next, self-hosted Docker)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "pnpm install --ignore-workspace",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
    "migrate:local": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "gen:redirects": "tsx scripts/gen-redirects.ts",
    "seed:dev": "cross-env NODE_OPTIONS=--no-deprecation SKIP_REVALIDATE=1 tsx scripts/seed-dev.ts",
    "test": "pnpm run test:int",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.2",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-trace": "2.12.1",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/translations": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "altcha": "3.5.0",
    "altcha-lib": "2.8.0",
    "clsx": "^2.1.1",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "graphql": "^16.8.1",
    "ioredis": "5.11.1",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "payload": "3.93.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "three": "0.160.1",
    "zod": "^4.6.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.6",
    "jsdom": "29.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  }
}
