{
  "name": "nasteh-bg",
  "version": "1.0.0",
  "description": "Nasteh OOD furniture-fittings catalog (Payload + Next, self-hosted Docker)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "pnpm install --ignore-workspace",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
    "migrate:local": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "gen:redirects": "tsx scripts/gen-redirects.ts",
    "import-products": "cross-env NODE_OPTIONS=--no-deprecation SKIP_REVALIDATE=1 tsx scripts/import-products.ts",
    "seed:dev": "cross-env NODE_OPTIONS=--no-deprecation SKIP_REVALIDATE=1 tsx scripts/seed-dev.ts",
    "test": "pnpm run test:int",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/translations": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "altcha": "3.2.1",
    "altcha-lib": "2.2.0",
    "clsx": "^2.1.1",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "ioredis": "5.11.1",
    "next": "15.4.11",
    "nodemailer": "^9.0.3",
    "payload": "3.86.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "0.34.5",
    "three": "0.160.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.12.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.11",
    "jsdom": "28.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": "^9 || ^10 || ^11"
  }
}
