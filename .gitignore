# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

/.idea/*
!/.idea/runConfigurations

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — EVERY variant (CLAUDE.md rule 10). `.env*` matters more than it
# looks: `.env.production` and `.env.backup` were previously NOT ignored, and a
# sysadmin's pre-edit backup of the real .env is exactly that shape.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


/media

# Local SQLite database files (dev)
*.db
*.db-journal
*.db-wal
*.db-shm

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Stale Cloudflare/OpenNext build artifacts (retired platform) — never commit
.open-next
.wrangler

# Local screenshot helper (redesign visual checks) — dev-only, never commit
/_shot.mjs