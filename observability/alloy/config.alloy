// Grafana Alloy — the one collector of the observability stack (DEPLOY §11).

// ── Logs: every container's json-file log → Loki ────────────────────────────
// Read from the mounted log directory (no Docker socket). docker-compose.yml
// tags each line with its service name (logging.options.labels).
local.file_match "containers" {
  path_targets = [{"__path__" = "/var/lib/docker/containers/*/*-json.log"}]
  sync_period  = "15s"
}

loki.source.file "containers" {
  targets       = local.file_match.containers.targets
  forward_to    = [loki.process.containers.receiver]
  tail_from_end = true
}

loki.process "containers" {
  stage.json {
    expressions = {
      log     = "log",
      stream  = "stream",
      time    = "time",
      service = "attrs.\"com.docker.compose.service\"",
    }
  }
  stage.timestamp {
    source = "time"
    format = "RFC3339Nano"
  }
  stage.labels {
    values = { service = "", stream = "" }
  }
  // The per-container file path only adds index entries; service says it all.
  stage.label_drop {
    values = ["filename"]
  }
  // Containers outside this stack carry no service tag.
  stage.match {
    selector = "{service=\"\"}"
    action   = "drop"
  }
  stage.output {
    source = "log"
  }

  // The app logs one JSON object per line (src/lib/log.ts).
  stage.match {
    selector = "{service=\"app\"}"
    stage.json {
      expressions = { level = "level", area = "area", traceId = "traceId" }
    }
    stage.labels {
      values = { level = "", area = "" }
    }
    stage.structured_metadata {
      values = { traceId = "" }
    }
  }

  // Redaction before storage: the app never logs personal data, but other
  // services do (Postfix logs recipients and client IPs).
  stage.replace {
    expression = "([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,})"
    replace    = "<email>"
  }
  stage.replace {
    expression = "\\b((?:\\d{1,3}\\.){3}\\d{1,3})\\b"
    replace    = "<ip>"
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ── Traces: app (OTLP) → Tempo, plus request metrics → Prometheus ───────────
otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  output {
    traces = [otelcol.connector.spanmetrics.default.input, otelcol.processor.filter.drop_health.input]
  }
}

// Health checks (compose healthcheck every 30 s + the uptime probe every
// 15 s) would be most of the stored traces. They still count in the request
// metrics above; only their traces are not kept.
otelcol.processor.filter "drop_health" {
  error_mode = "ignore"
  traces {
    span = ["attributes[\"next.route\"] == \"/api/health\""]
  }
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.connector.spanmetrics "default" {
  dimension {
    name = "http.status_code"
  }
  dimension {
    name = "next.route"
  }
  dimension {
    name = "http.method"
  }
  histogram {
    unit = "s"
    explicit {
      buckets = ["50ms", "100ms", "250ms", "500ms", "1s", "2.5s", "5s", "10s"]
    }
  }
  output {
    metrics = [otelcol.exporter.prometheus.default.input]
  }
}

otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

// ── Metrics: Postgres, Redis, uptime probe, disk → Prometheus ───────────────
local.file "metrics_password" {
  filename  = "/secrets/metrics_password"
  is_secret = true
}

prometheus.exporter.postgres "db" {
  data_source_names = [string.format(
    "postgresql://metrics:%s@db:5432/%s?sslmode=disable",
    string.trim_space(convert.nonsensitive(local.file.metrics_password.content)),
    sys.env("POSTGRES_DB"),
  )]
}

prometheus.exporter.redis "redis" {
  redis_addr = "redis:6379"
}

prometheus.exporter.blackbox "app" {
  config = "{ modules: { http_2xx: { prober: http, timeout: 5s, http: { valid_status_codes: [200] } } } }"
  target {
    name    = "app"
    address = "http://app:3000/api/health"
    module  = "http_2xx"
  }
}

// Disk space of the volume Docker stores everything on (seen from inside).
prometheus.exporter.unix "host" {
  set_collectors = ["filesystem", "meminfo", "loadavg"]
}

prometheus.scrape "exporters" {
  targets = array.concat(
    prometheus.exporter.postgres.db.targets,
    prometheus.exporter.redis.redis.targets,
    prometheus.exporter.blackbox.app.targets,
    prometheus.exporter.unix.host.targets,
  )
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
