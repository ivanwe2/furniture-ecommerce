          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM telemetry.events WHERE name = 'cart_add' AND source = 'web' AND $__timeFilter(ts)"
