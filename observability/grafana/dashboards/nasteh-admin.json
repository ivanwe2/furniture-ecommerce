    {
      "id": 5,
      "type": "timeseries",
      "title": "Admin saves per day, by collection",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', ts) AS time, props->>'collection' AS metric, count(*) AS value FROM telemetry.events WHERE name = 'admin_change' AND $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Most edited fields",
      "description": "e.g. products / items.stockQty edited daily → automate the stock sync.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT props->>'collection' AS \"collection\", f AS \"field\", count(*) AS \"edits\" FROM telemetry.events, jsonb_array_elements_text(props->'fields') AS f WHERE name = 'admin_change' AND $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 3 DESC LIMIT 30"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "table",
      "title": "Imports",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
