{
  "uid": "nasteh-admin",
  "title": "Admin usage (automation candidates)",
  "description": "What the owner does by hand in the admin — frequent, repetitive edits are the candidates for automation.",
  "tags": [
    "nasteh"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 41,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Admin saves",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM telemetry.events WHERE name = 'admin_change' AND $__timeFilter(ts)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
